# Choose one: groq | openai | gemini
# If left unset (or the matching API key is missing), the app falls back to an
# offline "extractive" mode that shows the most relevant retrieved passage
# instead of a generated answer, so it still runs end-to-end with no API key.
LLM_PROVIDER=groq

# Only the key matching LLM_PROVIDER above is required. Filling in a second
# provider's key here is also supported and enables automatic fallback:
# if LLM_PROVIDER's calls fail (after retries), the app tries any other
# configured provider before giving up - see llm_provider.call_llm().
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model for the selected provider.
LLM_MODEL=

# Optional: require this key (as an X-API-Key header) on the FastAPI backend
# (api.py). Leave unset to run the API with no auth gate (local/dev use).
API_KEY=

# Optional: path to a login-accounts file for app.py's login gate (see
# auth.py). Leave unset (default "users.json") - the app has no login prompt
# at all until you create the file with: python tools/manage_users.py add
AUTH_USERS_FILE=
