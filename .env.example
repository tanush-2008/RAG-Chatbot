# Choose one: groq | openai | gemini
# If left unset (or the matching API key is missing), the app falls back to an
# offline "extractive" mode that shows the most relevant retrieved passage
# instead of a generated answer, so it still runs end-to-end with no API key.
LLM_PROVIDER=groq

# Only the key matching LLM_PROVIDER above is required.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model for the selected provider.
LLM_MODEL=
